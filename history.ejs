<%- include('partials/header') %><div class="page-head"><div><span class="eyebrow">كل شيء موثق</span><h1>سجل مكتبتي</h1></div></div><section class="card"><div class="table-wrap"><table><thead><tr><th>العملية</th><th>التغيير</th><th>الرصيد قبل</th><th>الرصيد بعد</th><th>إجمالي الرحلة</th><th>التاريخ</th></tr></thead><tbody><% tx.forEach(t=>{ %><tr><td><%= t.reason||t.kind %></td><td class="<%= t.amount>=0?'positive':'negative' %>"><%= t.amount>0?'+':'' %><%= t.amount %></td><td><%= t.wallet_before %></td><td><%= t.wallet_after %></td><td><%= t.lifetime_after %></td><td><%= new Date(t.created_at).toLocaleString('ar-SA') %></td></tr><% }) %></tbody></table></div></section><%- include('partials/footer') %>
