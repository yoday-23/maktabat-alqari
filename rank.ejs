<%- include('partials/header') %>
<div class="page-head"><div><span class="eyebrow">رحلتك داخل المكتبة</span><h1>رتبتي</h1><p class="muted">كل رتبة محطة جديدة، والرتبة لا تنخفض عند صرف رصيدك في المتجر.</p></div></div>
<section class="rank-current"><div class="rank-icon"><%= p.rank.icon %></div><div><span>أنت الآن</span><h2><%= p.rank.name %></h2><p><%= p.rank.description %></p></div><strong><%= p.lifetime_minutes %> دقيقة</strong></section>
<% if(p.nextRank){ const range=p.nextRank.min_minutes-p.rank.min_minutes; const done=p.lifetime_minutes-p.rank.min_minutes; const pct=Math.max(0,Math.min(100,Math.round(done/range*100))); %><section class="card rank-next"><div class="row-between"><div><span class="eyebrow">المحطة التالية</span><h2><%= p.nextRank.icon %> <%= p.nextRank.name %></h2></div><strong>باقي <%= p.nextRank.min_minutes-p.lifetime_minutes %> دقيقة</strong></div><div class="progress large"><i style="width:<%= pct %>%"></i></div><small><%= p.lifetime_minutes %> / <%= p.nextRank.min_minutes %> دقيقة</small></section><% } %>
<div class="rank-path journey-path"><% ranks.forEach((r,i)=>{ const reached=p.lifetime_minutes>=r.min_minutes; const current=r.id===p.rank.id; %><div class="rank-step <%= reached?'reached':'' %> <%= current?'current':'' %>"><div class="rank-marker"><span><%= r.icon %></span></div><div><b><%= r.name %> <%= current?'<span class="you-are-here">أنت هنا</span>':'' %></b><small><%= r.description %></small><small>تبدأ من <%= r.min_minutes %> دقيقة</small></div><i><%= reached?'✓':i+1 %></i></div><% }) %></div>
<%- include('partials/footer') %>
