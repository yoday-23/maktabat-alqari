<%- include('partials/header') %>
<div class="page-head store-head"><div><span class="eyebrow">استثمر دقائقك</span><h1>متجر المكتبة</h1><p class="muted">اختر مكافأة تناسب رصيدك، أو اعرف كم بقي لك للوصول إليها.</p></div><div class="wallet-pill big">رصيدك <b><%= p.wallet_minutes %></b> دقيقة</div></div>
<% const available=rewards.filter(r=>{const rankOk=!r.min_rank_minutes||p.lifetime_minutes>=r.min_rank_minutes;return p.wallet_minutes>=r.price_minutes&&rankOk&&(!r.purchase_limit||r.my_purchases<r.purchase_limit)&&r.quantity>0}); const locked=rewards.filter(r=>!available.includes(r)); %>
<% if(available.length){ %><div class="store-section-title"><div><span>✨</span><div><h2>متاح لك الآن</h2><p>مكافآت تستطيع استبدالها فورًا</p></div></div></div><div class="reward-grid"><% available.forEach(r=>{ %><article class="reward-card available"><div class="reward-icon"><%= r.icon %></div><span class="stock">متبقي <%= r.quantity %></span><span class="ready-badge">جاهزة لك</span><h3><%= r.name %></h3><p><%= r.description %></p><div class="price"><b><%= r.price_minutes %></b> دقيقة</div><% if(r.min_rank_name){ %><small>متاحة من رتبة: <%= r.min_rank_name %></small><% } %><form method="post" action="/store/<%= r.id %>/buy"><button class="primary full" data-confirm="تأكيد استبدال <%= r.price_minutes %> دقيقة مقابل <%= r.name %>؟">استبدل الآن</button></form></article><% }) %></div><% } %>

<% if(locked.length){ %><div class="store-section-title locked-title"><div><span>🔒</span><div><h2>اقتربت منها</h2><p>واصل رحلتك لفتح هذه المكافآت</p></div></div></div><div class="reward-grid"><% locked.forEach(r=>{ const rankOk=!r.min_rank_minutes||p.lifetime_minutes>=r.min_rank_minutes; const moneyRemain=Math.max(0,r.price_minutes-p.wallet_minutes); const limitOk=!r.purchase_limit||r.my_purchases<r.purchase_limit; %><article class="reward-card locked"><div class="reward-icon"><%= r.icon %></div><span class="stock">متبقي <%= r.quantity %></span><h3><%= r.name %></h3><p><%= r.description %></p><div class="price"><b><%= r.price_minutes %></b> دقيقة</div><% if(r.quantity<=0){ %><div class="unlock-note">نفدت الكمية حاليًا</div><% } else if(!rankOk){ %><div class="unlock-note">🔒 تحتاج رتبة «<%= r.min_rank_name %>»</div><% } else if(!limitOk){ %><div class="unlock-note">وصلت للحد المسموح</div><% } else { %><div class="unlock-note">🔥 باقي لك <b><%= moneyRemain %></b> دقيقة فقط</div><% } %><button class="ghost full" disabled>غير متاحة الآن</button></article><% }) %></div><% } %>
<% if(!rewards.length){ %><div class="empty">لا توجد مكافآت متاحة حاليًا.</div><% } %>
<%- include('partials/footer') %>
