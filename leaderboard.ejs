<%- include('partials/header') %><div class="page-head"><div><span class="eyebrow">أهل الإنجاز</span><h1>🏆 لوحة المتميزين</h1></div></div><div class="podium"><% rows.slice(0,3).forEach((r,i)=>{ %><div class="podium-card place-<%= i+1 %>"><span><%= i===0?'🥇':i===1?'🥈':'🥉' %></span><h3><%= r.name %></h3><b><%= r.lifetime_minutes %> دقيقة</b></div><% }) %></div><section class="card"><table><thead><tr><th>#</th><th>المشارك</th><th>القراءة</th><th>الاستماع</th><th>الإجمالي</th></tr></thead><tbody><% rows.forEach((r,i)=>{ %><tr><td><%= i+1 %></td><td><b><%= r.name %></b></td><td><%= r.reading_minutes %></td><td><%= r.listening_minutes %></td><td><%= r.lifetime_minutes %></td></tr><% }) %></tbody></table></section><%- include('partials/footer') %>
