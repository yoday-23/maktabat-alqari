<%- include('partials/header') %><div class="page-head"><div><span class="eyebrow">مكافآتك</span><h1>قسائمي</h1></div></div><div class="voucher-grid"><% if(!vouchers.length){ %><div class="empty">لم تستبدل أي مكافأة بعد.</div><% } %><% vouchers.forEach(v=>{ %><article class="voucher"><div class="voucher-cut"></div><div><span class="voucher-icon"><%= v.icon %></span><h3><%= v.reward_name %></h3><p><%= v.description %></p><span class="status <%= v.status %>"><%= v.status==='unused'?'غير مستخدمة':v.status==='used'?'مستخدمة':v.status==='expired'?'منتهية':'ملغاة' %></span></div><div class="code"><small>رمز القسيمة</small><strong><%= v.code %></strong><small>استبدلت مقابل <%= v.price_minutes %> دقيقة</small></div></article><% }) %></div><%- include('partials/footer') %>
