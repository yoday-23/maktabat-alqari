<%- include('partials/header') %><div class="page-head"><div><span class="eyebrow">التحقق والاستعمال</span><h1>القسائم</h1></div></div><section class="card"><div class="table-wrap"><table><thead><tr><th>الرمز</th><th>المشارك</th><th>المكافأة</th><th>الحالة</th><th>الإجراء</th></tr></thead><tbody><% vouchers.forEach(v=>{ %><tr><td><code><%= v.code %></code></td><td><b><%= v.participant_name %></b></td><td><%= v.icon %> <%= v.reward_name %></td><td><span class="status <%= v.status %>"><%= v.status==='unused'?'غير مستخدمة':v.status==='used'?'مستخدمة':v.status==='expired'?'منتهية':'ملغاة' %></span></td><td><% if(v.status==='unused'){ %><div class="actions"><form method="post" action="/admin/vouchers/<%= v.id %>/use"><button class="mini primary" data-confirm="اعتماد استخدام القسيمة؟">اعتماد الاستخدام</button></form><form method="post" action="/admin/vouchers/<%= v.id %>/cancel"><button class="mini danger">إلغاء</button></form></div><% } %></td></tr><% }) %></tbody></table></div></section><%- include('partials/footer') %>
