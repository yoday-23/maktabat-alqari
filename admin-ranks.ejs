<%- include('partials/header') %>
<div class="page-head"><div><span class="eyebrow">سلم التقدم</span><h1>إدارة الرتب</h1></div></div>
<section class="card"><h2>إضافة رتبة</h2><form class="form-row" method="post" action="/admin/ranks/add"><input name="icon" value="📖" required><input name="name" placeholder="اسم الرتبة" required><input name="description" placeholder="الوصف"><input name="min_minutes" type="number" min="0" placeholder="حد الدقائق" required><input name="sort_order" type="number" min="1" placeholder="الترتيب" required><button class="primary">إضافة</button></form></section>
<div class="admin-cards"><% ranks.forEach(r=>{ %><form class="card rank-edit" method="post" action="/admin/ranks/<%= r.id %>/update"><div class="rank-icon small"><%= r.icon %></div><label>اسم الرتبة<input name="name" value="<%= r.name %>"></label><div class="form-row"><label>الأيقونة<input name="icon" value="<%= r.icon %>"></label><label>الحد الأدنى<input type="number" name="min_minutes" min="0" value="<%= r.min_minutes %>"></label><label>الترتيب<input type="number" name="sort_order" min="1" value="<%= r.sort_order %>"></label></div><label>الوصف<textarea name="description"><%= r.description %></textarea></label><label class="check"><input type="checkbox" name="active" <%= r.active?'checked':'' %>> الرتبة مفعلة</label><button class="primary full">حفظ</button></form><% }) %></div>
<%- include('partials/footer') %>
