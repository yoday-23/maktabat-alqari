<%- include('partials/header') %><div class="page-head"><div><span class="eyebrow">صلاحيات المدير</span><h1>المشرفون</h1></div></div><section class="card"><h2>إضافة مشرف</h2><form class="form-row" method="post" action="/admin/staff/add"><input name="name" placeholder="الاسم" required><input name="username" placeholder="اسم المستخدم" required><input name="password" type="password" minlength="8" placeholder="كلمة المرور" required><button class="primary">إضافة مشرف</button></form></section><div class="admin-list"><% staff.forEach(s=>{ %><article class="card"><div class="row-between"><div><h3><%= s.name %></h3><small>@<%= s.username %> • <%= s.role==='manager'?'مدير':'مشرف' %> • <%= s.active?'نشط':'معطل' %></small></div><% if(s.role==='supervisor'){ %><form method="post" action="/admin/staff/<%= s.id %>/toggle"><button class="ghost"><%= s.active?'تعطيل':'تفعيل' %></button></form><% } %></div><% if(s.role==='supervisor'){ %><form class="form-row compact" method="post" action="/admin/staff/<%= s.id %>/password"><input name="new_password" type="password" minlength="8" placeholder="كلمة مرور جديدة" required><button class="ghost">تغيير كلمة المرور</button></form><% } %></article><% }) %></div><%- include('partials/footer') %>
