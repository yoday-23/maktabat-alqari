<%- include('partials/header') %>
<div class="page-head"><div><span class="eyebrow">إدارة الحسابات</span><h1>المشاركون</h1><p class="muted">الرصيد لا يتغير من واجهة المشارك. أي تعديل إداري هنا يسجل في سجل المعاملات.</p></div></div>
<section class="card"><h2>إضافة مشارك</h2><form class="form-row" method="post" action="/admin/participants/add"><input name="name" placeholder="الاسم" required><input name="username" placeholder="اسم المستخدم" required><input name="password" type="password" minlength="8" placeholder="كلمة مرور مؤقتة" required><button class="primary">إضافة</button></form></section>
<div class="admin-list"><% participants.forEach(p=>{ const rank=getRank(p.lifetime_minutes); %><article class="card participant-admin-card"><div class="row-between"><div><h3><%= p.name %></h3><small>@<%= p.username %> • <%= rank.icon %> <%= rank.name %> • <%= p.active?'نشط':'معطل' %></small></div><div class="mini-stats"><span>الرحلة <b><%= p.lifetime_minutes %></b></span><span>الرصيد <b><%= p.wallet_minutes %></b></span><span>قراءة <b><%= p.reading_minutes %></b></span><span>استماع <b><%= p.listening_minutes %></b></span></div></div>
<details><summary>تعديل بيانات الحساب</summary><form class="form-row" method="post" action="/admin/participants/<%= p.id %>/update"><input name="name" value="<%= p.name %>" required><input name="username" value="<%= p.username %>" required><input name="new_password" type="password" minlength="8" placeholder="كلمة مرور جديدة (اختياري)"><button class="primary">حفظ</button></form></details>
<div class="admin-actions"><form method="post" action="/admin/participants/<%= p.id %>/toggle"><button class="ghost"><%= p.active?'تعطيل الحساب':'تفعيل الحساب' %></button></form><form class="form-row compact" method="post" action="/admin/participants/<%= p.id %>/adjust"><input name="amount" type="number" step="1" placeholder="+ أو - دقائق" required><input name="reason" placeholder="سبب التعديل" required><button class="ghost">تعديل الدقائق</button></form></div></article><% }) %></div>
<%- include('partials/footer') %>
