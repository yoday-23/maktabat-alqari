<%- include('partials/header') %>
<div class="page-head"><div><span class="eyebrow">خطة البرنامج</span><h1>إدارة الأسابيع</h1></div></div>
<section class="card"><h2>إضافة أسبوع</h2><form class="admin-form" method="post" action="/admin/weeks/add"><div class="form-grid"><label>رقم الأسبوع<input type="number" name="week_number" min="1" required></label><label>العنوان<input name="title" required></label><label>دقائق القراءة<input type="number" name="reading_target" min="0" value="40" required></label><label>دقائق الاستماع<input type="number" name="listening_target" min="0" value="30" required></label><label>البداية<input type="datetime-local" name="starts_at" required></label><label>النهاية<input type="datetime-local" name="ends_at" required></label><label>الحالة<select name="status"><option value="closed">مغلق</option><option value="open">مفتوح</option></select></label></div><label>وصف المهمة<textarea name="description"></textarea></label><button class="primary">إضافة الأسبوع</button></form></section>
<div class="admin-cards"><% weeks.forEach(w=>{ %><form class="card week-edit" method="post" action="/admin/weeks/<%= w.id %>/update"><div class="row-between"><span class="badge">الأسبوع <%= w.week_number %></span><select name="status"><option value="closed" <%= w.status==='closed'?'selected':'' %>>مغلق</option><option value="open" <%= w.status==='open'?'selected':'' %>>مفتوح</option></select></div><label>العنوان<input name="title" value="<%= w.title %>" required></label><div class="form-row"><label>دقائق القراءة<input type="number" min="0" name="reading_target" value="<%= w.reading_target %>"></label><label>دقائق الاستماع<input type="number" min="0" name="listening_target" value="<%= w.listening_target %>"></label></div><label>وصف المهمة<textarea name="description"><%= w.description %></textarea></label><div class="form-row"><label>البداية<input type="datetime-local" name="starts_at" value="<%= w.starts_at.slice(0,16) %>"></label><label>النهاية<input type="datetime-local" name="ends_at" value="<%= w.ends_at.slice(0,16) %>"></label></div><button class="primary full">حفظ الأسبوع</button></form><% }) %></div>
<%- include('partials/footer') %>
