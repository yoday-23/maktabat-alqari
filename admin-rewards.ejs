<%- include('partials/header') %>
<div class="page-head"><div><span class="eyebrow">متجر المكتبة</span><h1>إدارة المكافآت</h1></div></div>
<section class="card"><h2>إضافة مكافأة</h2><form method="post" action="/admin/rewards/add" class="admin-form"><div class="form-grid"><label>الاسم<input name="name" required></label><label>الأيقونة<input name="icon" value="🎁"></label><label>السعر بالدقائق<input type="number" name="price_minutes" min="1" required></label><label>الكمية<input type="number" name="quantity" min="0" required></label><label>تبدأ من<input type="datetime-local" name="available_from"></label><label>تنتهي في<input type="datetime-local" name="available_until"></label><label>الرتبة الدنيا<select name="min_rank_id"><option value="">بدون شرط</option><% ranks.forEach(r=>{ %><option value="<%= r.id %>"><%= r.icon %> <%= r.name %></option><% }) %></select></label><label>حد الشراء<input type="number" name="purchase_limit" min="1" placeholder="اتركه فارغًا بلا حد"></label></div><label>الوصف<textarea name="description"></textarea></label><button class="primary">إضافة المكافأة</button></form></section>
<div class="admin-cards"><% rewards.forEach(r=>{ %><article class="card"><div class="row-between"><div><h3><%= r.icon %> <%= r.name %></h3><small><%= r.active?'مفعلة':'متوقفة' %> • تم شراؤها <%= r.buys %> مرة • استخدمت <%= r.used %> قسيمة</small></div><form method="post" action="/admin/rewards/<%= r.id %>/toggle"><button class="ghost"><%= r.active?'إيقاف':'تفعيل' %></button></form></div><details><summary>تعديل المكافأة</summary><form method="post" action="/admin/rewards/<%= r.id %>/update" class="admin-form"><div class="form-grid"><label>الاسم<input name="name" value="<%= r.name %>" required></label><label>الأيقونة<input name="icon" value="<%= r.icon %>"></label><label>السعر<input type="number" name="price_minutes" min="1" value="<%= r.price_minutes %>" required></label><label>الكمية<input type="number" name="quantity" min="0" value="<%= r.quantity %>" required></label><label>تبدأ من<input type="datetime-local" name="available_from" value="<%= r.available_from?r.available_from.slice(0,16):'' %>"></label><label>تنتهي في<input type="datetime-local" name="available_until" value="<%= r.available_until?r.available_until.slice(0,16):'' %>"></label><label>الرتبة الدنيا<select name="min_rank_id"><option value="">بدون شرط</option><% ranks.forEach(k=>{ %><option value="<%= k.id %>" <%= r.min_rank_id===k.id?'selected':'' %>><%= k.icon %> <%= k.name %></option><% }) %></select></label><label>حد الشراء<input type="number" name="purchase_limit" min="1" value="<%= r.purchase_limit||'' %>"></label></div><label>الوصف<textarea name="description"><%= r.description||'' %></textarea></label><button class="primary">حفظ التعديلات</button></form></details></article><% }) %></div>
<%- include('partials/footer') %>
