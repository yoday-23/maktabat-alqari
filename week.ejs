<%- include('partials/header') %>
<% const approvedReading=logs.filter(l=>l.activity_type==='reading'&&l.status==='approved').reduce((s,l)=>s+l.minutes,0); const approvedListening=logs.filter(l=>l.activity_type==='listening'&&l.status==='approved').reduce((s,l)=>s+l.minutes,0); const pendingReading=logs.filter(l=>l.activity_type==='reading'&&l.status==='pending').reduce((s,l)=>s+l.minutes,0); const pendingListening=logs.filter(l=>l.activity_type==='listening'&&l.status==='pending').reduce((s,l)=>s+l.minutes,0); %>
<div class="page-head"><div><span class="eyebrow">المهمة الحالية</span><h1>هذا الأسبوع</h1><p class="muted">اعرف هدفك، سجّل دقائقك، واترك الاعتماد للمشرف.</p></div></div>
<% if(week){ %>
<section class="card week-summary"><div><span class="badge">الأسبوع <%= week.week_number %></span><h2><%= week.title %></h2><p><%= week.description %></p></div><div class="week-goals"><div><span>📖</span><b><%= week.reading_target %></b><small>دقيقة قراءة</small></div><div><span>🎧</span><b><%= week.listening_target %></b><small>دقيقة استماع</small></div></div></section>

<div class="grid two week-layout"><section class="card submit-card"><span class="eyebrow">أضف دقائقك</span><h2>سجّل إنجازك</h2><p class="muted">اختر النشاط أولًا، ثم أدخل عدد الدقائق فقط.</p><form method="post" action="/week/submit" id="activity-form"><input type="hidden" name="activity_type" id="activity_type" value="reading"><div class="activity-picker"><button type="button" class="activity-choice active" data-activity="reading"><span>📖</span><b>قراءة</b></button><button type="button" class="activity-choice" data-activity="listening"><span>🎧</span><b>استماع</b></button></div><label>عدد الدقائق<input type="number" name="minutes" min="1" max="1440" inputmode="numeric" placeholder="مثال: 30" required></label><label>ملاحظة <small class="muted">اختيارية</small><textarea name="notes" rows="3" placeholder="اسم الكتاب أو المادة إن أحببت"></textarea></label><button class="primary full">إرسال للمراجعة</button></form></section>

<section class="card week-status"><span class="eyebrow">حالتك الآن</span><h2>تقدم الأسبوع</h2><div class="status-goal"><div><span>📖 القراءة</span><b><%= approvedReading %> / <%= week.reading_target %></b></div><div class="progress"><i style="width:<%= Math.min(100,Math.round(approvedReading/week.reading_target*100)) %>%"></i></div><small>معتمد: <%= approvedReading %> دقيقة <% if(pendingReading){ %>• قيد المراجعة: <%= pendingReading %><% } %></small></div><div class="status-goal"><div><span>🎧 الاستماع</span><b><%= approvedListening %> / <%= week.listening_target %></b></div><div class="progress"><i style="width:<%= Math.min(100,Math.round(approvedListening/week.listening_target*100)) %>%"></i></div><small>معتمد: <%= approvedListening %> دقيقة <% if(pendingListening){ %>• قيد المراجعة: <%= pendingListening %><% } %></small></div><div class="review-note">⏳ الدقائق المرسلة لا تدخل رصيدك إلا بعد اعتماد المشرف.</div></section></div>

<section class="card"><div class="section-title"><h2>إنجازاتي هذا الأسبوع</h2><span class="muted"><%= logs.length %> عمليات</span></div><div class="log-cards"><% if(!logs.length){ %><p class="muted">لم ترسل أي إنجاز حتى الآن.</p><% } %><% logs.forEach(l=>{ %><article class="log-card"><div class="log-icon"><%= l.activity_type==='reading'?'📖':'🎧' %></div><div><b><%= l.activity_type==='reading'?'قراءة':'استماع' %> — <%= l.minutes %> دقيقة</b><small><%= new Date(l.submitted_at).toLocaleDateString('ar-SA') %></small></div><span class="status <%= l.status %>"><%= l.status==='pending'?'بانتظار الاعتماد':l.status==='approved'?'معتمد':'مرفوض' %></span></article><% }) %></div></section>
<% } else { %><div class="empty">لا يوجد أسبوع مفتوح حاليًا.</div><% } %>
<%- include('partials/footer') %>
