<%- include('partials/header') %><div class="page-head"><div><span class="eyebrow">مراجعة الإنجازات</span><h1>الإنجازات المعلقة</h1></div><span class="badge"><%= logs.length %> بانتظارك</span></div><div class="approval-list"><% if(!logs.length){ %><div class="empty">لا توجد إنجازات معلقة 🎉</div><% } %><% logs.forEach(l=>{ %><article class="card approval"><div><span class="avatar"><%= l.name.charAt(0) %></span><div><h3><%= l.name %></h3><p>الأسبوع <%= l.week_number %> — <%= l.activity_type==='reading'?'📖 قراءة':'🎧 استماع' %></p></div></div><strong><%= l.minutes %> دقيقة</strong><form method="post"><input name="note" placeholder="ملاحظة اختيارية"><div class="actions"><button class="primary" formaction="/admin/approvals/<%= l.id %>/approve">✓ اعتماد</button><button class="danger" formaction="/admin/approvals/<%= l.id %>/reject">رفض</button></div></form></article><% }) %></div><%- include('partials/footer') %>
