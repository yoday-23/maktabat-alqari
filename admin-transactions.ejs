<%- include('partials/header') %><div class="page-head"><div><span class="eyebrow">تدقيق كامل</span><h1>سجل المعاملات</h1><p class="muted">آخر 500 عملية مع الرصيد قبل وبعد ومن نفذ العملية.</p></div></div><section class="card table-wrap"><table><thead><tr><th>التاريخ</th><th>المشارك</th><th>النوع</th><th>الدقائق</th><th>الرصيد قبل</th><th>الرصيد بعد</th><th>إجمالي الرحلة قبل</th><th>إجمالي الرحلة بعد</th><th>السبب</th><th>نفذها</th></tr></thead><tbody><% rows.forEach(t=>{ %><tr><td><%= new Date(t.created_at).toLocaleString('ar-SA') %></td><td><%= t.participant_name %></td><td><%= t.kind %></td><td><%= t.amount %></td><td><%= t.wallet_before %></td><td><%= t.wallet_after %></td><td><%= t.lifetime_before %></td><td><%= t.lifetime_after %></td><td><%= t.reason||'-' %></td><td><%= t.actor_name||'النظام' %></td></tr><% }) %></tbody></table></section><%- include('partials/footer') %>
